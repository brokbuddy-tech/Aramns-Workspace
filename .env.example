# Private Node/server settings. This is an individual BROKER template.
# Never substitute an agency code, use a browser prefix, or put codes in URLs.
BROKBUDDY_API_BASE_URL=https://api.brokbuddy.si
BROKBUDDY_BROKER_PROFILE_SLUG=your-broker-slug
BROKBUDDY_BROKER_CODE=replace-with-issued-32-lowercase-hex-code
PORT=3000

# Public browser Maps key: restrict it to this website's domains in Google Cloud.
# Node exposes ONLY these Maps settings through /api/maps-config at runtime.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=8f9c7f3389f798b89cdc534a

# Native website feedback defaults to this independent broker's settings above.
# Select agency ONLY on an agency deployment, using that agency's own code/domain.
BROKBUDDY_FEEDBACK_SCOPE=broker
# BROKBUDDY_AGENCY_SLUG=your-agency-slug
# BROKBUDDY_AGENCY_CODE=replace-with-that-agencys-issued-code
# Optional canonical Origin for review POSTs (scheme + host, no trailing slash).
# Set separately on each website; no agency origin/credential inheritance.
# BROKBUDDY_FEEDBACK_WEBSITE_ORIGIN=https://your-website.example
