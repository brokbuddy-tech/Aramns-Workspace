# Server only. Supply operator-managed values; never use a VITE_ prefix.
BROKBUDDY_API_BASE_URL=https://api.brokbuddy.si
BROKBUDDY_BROKER_PROFILE_SLUG=your-broker-slug
BROKBUDDY_BROKER_CODE=replace-with-issued-32-lowercase-hex-code
PORT=3000

# Public browser Maps key: restrict it to this website's domains in Google Cloud.
# Node exposes ONLY these Maps settings through /api/maps-config at runtime.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=8f9c7f3389f798b89cdc534a
